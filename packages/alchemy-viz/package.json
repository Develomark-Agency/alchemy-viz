{
  "name": "alchemy-viz",
  "version": "0.1.1",
  "private": true,
  "description": "A local dashboard for exploring and interacting with Alchemy stacks.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "dashboard",
    "devtools",
    "infrastructure-as-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Develomark-Agency/alchemy-viz.git",
    "directory": "packages/alchemy-viz"
  },
  "homepage": "https://github.com/Develomark-Agency/alchemy-viz#readme",
  "bugs": "https://github.com/Develomark-Agency/alchemy-viz/issues",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "bin": {
    "alchemy-viz": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "alchemy-viz-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "alchemy-viz-source": "./src/server/define.ts",
      "types": "./dist/server/define.d.mts",
      "default": "./dist/server/define.mjs"
    },
    "./client": {
      "alchemy-viz-source": "./src/client/index.tsx",
      "types": "./dist/client/index.d.mts",
      "default": "./dist/client/index.mjs"
    },
    "./ui": {
      "alchemy-viz-source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.mts",
      "default": "./dist/ui/index.mjs"
    },
    "./ui/theme.css": {
      "alchemy-viz-source": "./src/ui/theme.css",
      "default": "./dist/ui/theme.css"
    },
    "./cloudflare": {
      "alchemy-viz-source": "./src/plugins/cloudflare/index.ts",
      "types": "./dist/plugins/cloudflare/index.d.mts",
      "default": "./dist/plugins/cloudflare/index.mjs"
    },
    "./turso": {
      "alchemy-viz-source": "./src/plugins/turso/index.ts",
      "types": "./dist/plugins/turso/index.d.mts",
      "default": "./dist/plugins/turso/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.1.0",
    "@xyflow/react": "^13.0.3",
    "cmd-ts": "0.15.0",
    "cn": "0.5.2",
    "elkjs": "^0.12.1",
    "exsolve": "^1.2.0",
    "lucide-react": "^1.78.0",
    "motion": "14.14.0",
    "mysql2": "^3.24.6",
    "papaparse": "^5.7.1",
    "postgres": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.87",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  }
}
