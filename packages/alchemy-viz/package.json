    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.87",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
