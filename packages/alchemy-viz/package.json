    "./client": "./src/client/index.tsx",
    "./ui": "./src/ui/index.ts",
    "./ui/styles.css": "./src/ui/styles.css",
    "./cloudflare": "./src/plugins/cloudflare/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
