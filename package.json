{
  "name": "alchemy-viz-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "trustedDependencies": [
    "workerd",
    "esbuild"
  ],
  "scripts": {
    "build": "bun run --filter alchemy-viz build",
    "typecheck": "tsc -p . && bun run --filter '*' typecheck",
    "lint": "oxlint",
    "check": "bun run typecheck && bun run lint && bun run build",
    "smoke": "bun scripts/smoke-test.ts",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/bun": "^1.4.5",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  }
}
