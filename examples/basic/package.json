{
  "name": "example-basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "viz": "alchemy-viz",
    "typecheck": "tsc --noEmit",
    "seed": "bun scripts/seed.ts",
    "db:up": "docker run -d --name alchemy-viz-example-pg -p 54329:5432 -e POSTGRES_USER=app -e POSTGRES_PASSWORD=app -e POSTGRES_DB=app -v ./postgres/init.sql:/docker-entrypoint-initdb.d/init.sql:ro postgres:16",
    "db:down": "docker rm -f alchemy-viz-example-pg"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "^4.20251120.0",
    "@effect/platform-bun": "^4.1.4",
    "@effect/platform-node": "^4.1.4",
    "alchemy": "2.0.0-beta.87",
    "effect": "^4.1.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "alchemy-viz": "workspace:*",
    "lucide-react": "^1.78.0",
    "react": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "zod": "^4.6.7"
  }
}
